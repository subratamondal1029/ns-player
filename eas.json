{
  "cli": {
    "version": ">= 24.10.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal"
    },
    "production": {
      "autoIncrement": true
    },
    "local": {
      "distribution": "internal",
      "environment": "production",
      "env": {
        "GRADLE_OPTS": "-Dorg.gradle.jvmargs=\"-Xmx6144m -XX:MaxMetaspaceSize=1024m -XX:+HeapDumpOnOutOfMemoryError -Dfile.encoding=UTF-8\""
      },
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleRelease --stacktrace"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
