{
  "expo": {
    "name": "NS Player",
    "slug": "ns-player",
    "version": "2.1.0-beta.6",
    "orientation": "portrait",
    "icon": "./assets/ios/AppIcon~ios-marketing.png",
    "scheme": "nsplayer",
    "userInterfaceStyle": "dark",
    "ios": {
      "icon": "./assets/ios/AppIcon~ios-marketing.png",
      "userInterfaceStyle": "dark",
      "bundleIdentifier": "com.subratamondal.nsplayer"
    },
    "android": {
      "package": "com.subratamondal.nsplayer",
      "versionCode": 10,
      "userInterfaceStyle": "dark",
      "adaptiveIcon": {
        "backgroundColor": "#0a0a0a",
        "foregroundImage": "./assets/android/res/mipmap-xxxhdpi/ic_launcher_foreground.png",
        "backgroundImage": "./assets/android/res/mipmap-xxxhdpi/ic_launcher_background.png",
        "monochromeImage": "./assets/android/res/mipmap-xxxhdpi/ic_launcher_monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/web/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0a0a0a",
          "image": "./assets/splash/icon.png",
          "imageWidth": 150,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#0a0a0a",
            "image": "./assets/splash/icon.png",
            "resizeMode": "contain"
          }
        }
      ],
      [
        "expo-video",
        {
          "supportsPictureInPicture": true
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "expo-media-control",
        {
          "enableBackgroundAudio": false
        }
      ],
      "expo-image",
      "expo-web-browser",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow $(PRODUCT_NAME) to access camera to scan sync QR code.",
          "recordAudioAndroid": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "39623b31-499e-4430-8596-1d038536a741"
      }
    }
  }
}
